{
  "name": "nexus-it-command-center",
  "version": "1.2.0",
  "private": true,
  "description": "Enterprise IT operations, endpoint monitoring and troubleshooting platform.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "agent": "node agent/index.js",
    "check": "node --check server/index.js && node --check server/db.js && node --check server/security.js && node --check agent/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.8",
    "vite": "^6.0.7",
    "ws": "^8.18.0",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {}
}
